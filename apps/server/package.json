{
  "name": "portfolio-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types ./worker-configuration.d.ts",
    "check:db": "node --env-file=.dev.vars scripts/check-db.mjs",
    "test:postman": "npx -y newman@6 run postman/Full-Suite.postman_collection.json -e postman/TCOS-Local.postman_environment.json",
    "seed:dev": "node --env-file=.dev.vars scripts/seed-dev.mjs",
    "token": "node --env-file=.dev.vars scripts/make-token.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "mongodb": "^6.15.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.20.0",
    "yaml": "^2.9.1"
  }
}
