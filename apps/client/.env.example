# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`.
# Leave values empty here. Never put a secret in a NEXT_PUBLIC_ variable.

# The Express server's base URL (the server Worker's URL)
API_URL=
# Same value as the server's REVALIDATE_SECRET
REVALIDATE_SECRET=
# Public URL of the R2 media bucket, allowed for next/image (read at build time)
MEDIA_BASE_URL=
# "true" serves the fixtures in fixtures/ instead of calling API_URL
USE_FIXTURES=true
# The editor's origin (e.g. http://localhost:3001), allowed to use edit mode at /edit. Leave unset in production unless the editor is hosted.
EDITOR_ORIGIN=
