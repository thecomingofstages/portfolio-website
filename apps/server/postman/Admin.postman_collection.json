{
  "info": {
    "_postman_id": "c1107343-eeb0-4b55-944a-45229544b955",
    "name": "TCOS - Admin",
    "description": "TCOS portfolio API (public, read-only). Import TCOS-Local.postman_environment.json first. List requests save a real slug/key for the detail requests; with an empty database those are skipped. Never save a real admin token in these files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "No token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error body { error }\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));",
              "pm.test(\"says only Unauthorized\", () => pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" }));",
              "pm.test(\"WWW-Authenticate: Bearer\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Not a JWT -> 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer not-a-jwt"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error body { error }\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));",
              "pm.test(\"says only Unauthorized\", () => pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" }));",
              "pm.test(\"WWW-Authenticate: Bearer\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Wrong signature -> 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ4In0.c2lnbmF0dXJlLW5vdC12YWxpZA"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error body { error }\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));",
              "pm.test(\"says only Unauthorized\", () => pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" }));",
              "pm.test(\"WWW-Authenticate: Bearer\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Valid token passes auth",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": "Set {{adminToken}} in the environment first: npm run token -- --for <you>. Never save a real token in this file."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.environment.get(\"adminToken\");",
              "if (!v || v === \"<...>\") { console.log(\"skipped: no adminToken (empty database?)\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"not 401: the token is accepted\", () => pm.expect(pm.response.code).to.not.eql(401));"
            ]
          }
        }
      ]
    }
  ]
}