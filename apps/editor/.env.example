# Copy to .env.local for `npm run dev`. Leave values empty here (docs/EDITOR.md "Auth and settings").
# Never put a secret in a NEXT_PUBLIC_ variable.

# The Express server's base URL (the server Worker's URL), for the admin API
API_URL=
# A hand-made admin JWT (docs/API.md "Auth"). Read only on the editor's server.
ADMIN_TOKEN=
# The public site's base URL, e.g. http://localhost:3000: editing on the page, and "Open on the site" links.
# The client needs EDITOR_ORIGIN set to this editor's origin. Optional: without it, the panel alone edits blocks.
SITE_URL=
# The R2 media bucket's public URL: the client's MEDIA_BASE_URL. Picture URLs from anywhere else are refused,
# because the site cannot show them. Public, not a secret.
NEXT_PUBLIC_MEDIA_BASE_URL=
# "true" edits the in-memory fixtures in fixtures/ instead of calling API_URL
USE_FIXTURES=true
