  "item": [
    {
      "name": "No token -> 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"error body { error }\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));",
              "pm.test(\"says only Unauthorized\", () => pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" }));",
              "pm.test(\"WWW-Authenticate: Bearer\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
            ]
          }
        }
      ]
    },
