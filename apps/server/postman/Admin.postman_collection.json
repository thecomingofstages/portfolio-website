    {
      "name": "Valid token passes auth",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "projects"
          ]
        },
        "description": "Set {{adminToken}} in the environment first: npm run token -- --for <you>. Never save a real token in this file."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.environment.get(\"adminToken\");",
              "if (!v || v === \"<...>\") { console.log(\"skipped: no adminToken (empty database?)\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"not 401: the token is accepted\", () => pm.expect(pm.response.code).to.not.eql(401));"
            ]
          }
        }
      ]
    },
