# Copy to .env.local for `npm run dev`. Leave values empty here (docs/EDITOR.md "Auth and settings").
# Never put a secret in a NEXT_PUBLIC_ variable.

# The Express server's base URL (the server Worker's URL), for the admin API
API_URL=
# A hand-made admin JWT (docs/API.md "Auth"). Read only on the editor's server.
ADMIN_TOKEN=
# The public site's base URL, for the preview and "Open on the site" links, e.g. http://localhost:3000. Optional.
SITE_URL=
# "true" edits the in-memory fixtures in fixtures/ instead of calling API_URL
USE_FIXTURES=true
