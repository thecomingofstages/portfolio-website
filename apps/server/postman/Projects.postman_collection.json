{
  "info": {
    "_postman_id": "ae6ef4ed-27b3-4850-9ede-07278f60e7d8",
    "name": "TCOS - Projects",
    "description": "TCOS portfolio API (public, read-only). Import TCOS-Local.postman_environment.json first. List requests save a real slug/key for the detail requests; with an empty database those are skipped. Never save a real admin token in these files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "description": "Shown projects, newest first. Saves the first slug as {{projectSlug}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"no _id or consent flags (privacy)\", () => {",
              "  const t = pm.response.text();",
              "  [\"\\\"_id\\\"\", \"\\\"is_shown\\\"\", \"\\\"is_photo_allowed\\\"\", \"\\\"logo_permission\\\"\"].forEach((k) => pm.expect(t).to.not.include(k));",
              "});",
              "const list = pm.response.json();",
              "pm.test(\"is a list\", () => pm.expect(list).to.be.an(\"array\"));",
              "list.forEach((p, i) => pm.test(`card ${i}: shape and at most one pic`, () => {",
              "  pm.expect(p).to.have.all.keys(\"slug\", \"name\", \"start_date\", \"pics\");",
              "  pm.expect(p.pics.length).to.be.at.most(1);",
              "}));",
              "pm.test(\"newest first\", () => {",
              "  const d = list.map((p) => Date.parse(p.start_date));",
              "  pm.expect(d).to.eql([...d].sort((a, b) => b - a));",
              "});",
              "// Save a real slug for the next requests.",
              "pm.environment.set(\"projectSlug\", list[0] ? list[0].slug : \"\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Get project",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectSlug}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects",
            "{{projectSlug}}"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.environment.get(\"projectSlug\");",
              "if (!v || v === \"<...>\") { console.log(\"skipped: no projectSlug (empty database?)\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.test(\"no _id or consent flags (privacy)\", () => {",
              "  const t = pm.response.text();",
              "  [\"\\\"_id\\\"\", \"\\\"is_shown\\\"\", \"\\\"is_photo_allowed\\\"\", \"\\\"logo_permission\\\"\"].forEach((k) => pm.expect(t).to.not.include(k));",
              "});",
              "const p = pm.response.json();",
              "pm.test(\"shape: slug, name, start_date, end_date, venue, pics, is_yearbook_shown, blocks\", () => pm.expect(p).to.have.all.keys(\"slug\", \"name\", \"start_date\", \"end_date\", \"venue\", \"pics\", \"is_yearbook_shown\", \"blocks\"));",
              "pm.test(\"blocks have id, type, title\", () => p.blocks.forEach((b) => pm.expect(b).to.include.keys(\"id\", \"type\", \"title\")));",
              "pm.environment.set(\"yearbookShown\", String(p.is_yearbook_shown));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get yearbook",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectSlug}}/yearbook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "projects",
            "{{projectSlug}}",
            "yearbook"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const v = pm.environment.get(\"projectSlug\");",
              "if (!v || v === \"<...>\") { console.log(\"skipped: no projectSlug (empty database?)\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"no _id or consent flags (privacy)\", () => {",
              "  const t = pm.response.text();",
              "  [\"\\\"_id\\\"\", \"\\\"is_shown\\\"\", \"\\\"is_photo_allowed\\\"\", \"\\\"logo_permission\\\"\"].forEach((k) => pm.expect(t).to.not.include(k));",
              "});",
              "const shown = pm.environment.get(\"yearbookShown\") === \"true\";",
              "pm.test(shown ? \"status 200 (yearbook shown)\" : \"status 404 (yearbook not shown)\", () => pm.response.to.have.status(shown ? 200 : 404));",
              "if (shown) {",
              "  const y = pm.response.json();",
              "  pm.test(\"shape\", () => pm.expect(y).to.have.all.keys(\"slug\", \"name\", \"pics\", \"departments\"));",
              "  pm.test(\"members have name, nickname, position, photo\", () => y.departments.forEach((d) =>",
              "    d.members.forEach((m) => pm.expect(m).to.have.all.keys(\"name\", \"nickname\", \"position\", \"photo\"))));",
              "}"
            ]
          }
        }
      ]
    },
    {
